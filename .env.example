# ----------------------------------------------------------------------
# CARD PHOTO READING (Cards screen)
# ----------------------------------------------------------------------
# GEMINI_API_KEY: free at aistudio.google.com. Leave it EMPTY if you have none: any text here
# (even a placeholder) counts as "configured" and the app will try to use it.
GEMINI_API_KEY=
# GEMINI_VISION_MODEL: optional model name override (letters, digits, dot, dash, underscore only).
GEMINI_VISION_MODEL=
# GEMINI_DAILY_CAP: most card-photo reads per day for the whole server (default 100). Photo reads are also
# limited to 5 per minute per device.
GEMINI_DAILY_CAP=
# POKEMONTCG_API_KEY: optional, from dev.pokemontcg.io. Raises the card-database rate limit.
POKEMONTCG_API_KEY=
# CARD_GRADES_FILE: where saved real grades are kept (default data/card-grades.json).
CARD_GRADES_FILE=
# BRAIN_FILE: where the app's learning data is kept (default data/brain.json).
BRAIN_FILE=

# ----------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------
# HOST: defaults to 127.0.0.1 (this computer only). 0.0.0.0 opens it to the network; set the Basic Auth
# user and password below first.
HOST=
# PORT: defaults to 3000.
PORT=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# ----------------------------------------------------------------------
# AMAZON CREATORS API (Official Replacement for Deprecated PA-API 5)
# ----------------------------------------------------------------------
# OAuth 2.0 Credential ID from Amazon Creators Console
AMAZON_CREATORS_CREDENTIAL_ID=
# OAuth 2.0 Credential Secret
AMAZON_CREATORS_CREDENTIAL_SECRET=
# Credential Version (e.g. "2.1")
AMAZON_CREATORS_CREDENTIAL_VERSION="2.1"
# Amazon Associates / Influencer Partner Tag (e.g. "reseller-20").
# Also used to tag every Amazon coupon "Claim" link (server/coupons/affiliate.ts).
AMAZON_PARTNER_TAG=
# Amazon Marketplace Country Code (e.g. "US", "CA", "UK")
AMAZON_MARKETPLACE="US"

# ----------------------------------------------------------------------
# EBAY OFFICIAL APIS (Catalog API, Browse API & Marketplace Insights)
# ----------------------------------------------------------------------
# eBay Developer Program App ID (Client ID)
EBAY_CLIENT_ID=
# eBay Developer Program Cert ID (Client Secret)
EBAY_CLIENT_SECRET=
# eBay Environment ("PRODUCTION" or "SANDBOX")
EBAY_ENVIRONMENT="PRODUCTION"
# eBay Marketplace ID (default "EBAY_US")
EBAY_MARKETPLACE_ID="EBAY_US"
# eBay Marketplace Insights Commercial Partner Approval ("true" or "false")
EBAY_MARKETPLACE_INSIGHTS_APPROVED="false"
# OAuth scopes (space-separated). Default is the base scope, which is all Browse search needs.
# Only add catalog/insights scopes if eBay has granted them to your app.
EBAY_OAUTH_SCOPES="https://api.ebay.com/oauth/api_scope"

# ----------------------------------------------------------------------
# DAILY DEAL DIGEST (npm run digest)
# ----------------------------------------------------------------------
# ZIP code for closest-first sorting
DIGEST_ZIP=
# Search radius for nearby stores, in miles (default 40)
DIGEST_RADIUS_MILES=
# How far back to look for posts, in hours (default 36)
DIGEST_LOOKBACK_HOURS=
# Folder the daily digest files are written to (default digests)
DIGEST_OUT_DIR=
# Folder for cached lookups (default digest/.cache)
DIGEST_CACHE_DIR=
# Comma-separated subreddits to read (default pennyhunting,PokemonRestocks)
DIGEST_REDDIT_SUBS=
# Reddit "script" app from reddit.com/prefs/apps. Without these Reddit is skipped and the digest says so.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ----------------------------------------------------------------------
# POKÉMON DROPS (Drops screen + Discord alerts)
# ----------------------------------------------------------------------
# Best Buy's official API: free key with an email signup at developer.bestbuy.com.
# Without it the Drops screen skips Best Buy and says so.
BESTBUY_API_KEY=
# Optional: exact Best Buy SKUs to watch, comma-separated. Empty = keyword search for Pokémon TCG products.
BESTBUY_POKEMON_SKUS=
# Most store-availability checks per refresh (each is one Best Buy call). Default 8, max 25.
BESTBUY_MAX_STORE_CHECKS=
# Discord alerts: in YOUR channel, Edit Channel > Integrations > Webhooks > New Webhook > Copy URL.
# Treat it like a password. Alerts are off while this is empty.
DISCORD_DROPS_WEBHOOK_URL=
# ZIP the alerts watch (falls back to DIGEST_ZIP).
DROP_ALERTS_ZIP=
# Minutes between alert checks (default 10, minimum 5).
DROP_ALERTS_EVERY_MINUTES=
# Where user sighting reports and alert state are kept (defaults data/pokemon-sightings.json, data/drop-alert-state.json).
POKEMON_SIGHTINGS_FILE=
DROP_ALERTS_STATE_FILE=

# ----------------------------------------------------------------------
# COUPON NETWORKS (server/coupons/sources/*.ts)
# ----------------------------------------------------------------------
# All optional and all currently scaffolds — see the comment at the top of each
# sources/*.ts file. Their real API docs are gated behind an approved publisher
# account, so setting these enables the source (marks it "not_implemented" in
# GET /api/coupons/sources) but fetchCoupons() won't return real data until the
# endpoint is finished against your account's actual docs. The internal coupon
# store (admin page, data/coupons.json) works today with none of these set.

# Rakuten Advertising — developers.rakutenadvertising.com (publisher signup required)
RAKUTEN_API_TOKEN=
RAKUTEN_SITE_ID=
# Impact.com — app.impact.com (partner signup required)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# CJ Affiliate / Commission Junction — cj.com (publisher signup required)
CJ_PERSONAL_ACCESS_TOKEN=
CJ_WEBSITE_ID=
# Sovrn Commerce (formerly VigLink) — sovrn.com (account signup required)
SOVRN_API_KEY=

# ----------------------------------------------------------------------
# TUNNEL BASIC AUTH (only if exposing the server via Cloudflare Tunnel/ngrok)
# ----------------------------------------------------------------------
# Off by default. Set both before running a public tunnel so the API isn't
# wide open to anyone who finds the URL. Not needed for Tailscale (private network).
TUNNEL_BASIC_AUTH_USER=
TUNNEL_BASIC_AUTH_PASS=

# TikTok Shop seller channel (Phase 1 foundation only: seller authorization. NOT mounted in the app yet.
# TikTok's endpoint URLs and OAuth parameters are UNVERIFIED; see server/marketplace/TIKTOK_PHASE1_STATUS.md.)
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_OAUTH_STATE_SECRET=
# Space-separated scopes approved for this app. Do not broaden without TikTok approval.
TIKTOK_SCOPES=
TIKTOK_AUTHORIZATION_URL=https://auth.tiktok-shops.com/oauth/authorize
TIKTOK_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/oauth/token
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
